ns-setup-116","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#full-dmarc-record-example","content":"`pct=100`"},"6824":{"id":"/docs/guides/dns-setup-117","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#full-dmarc-record-example","content":"Apply policy to 100% of failing emails"},"6825":{"id":"/docs/guides/dns-setup-118","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"If you are on the **Pro** tier or above and want to receive email through NorthRelay's inbox, add an MX record pointing to NorthRelay's mailbox server."},"6826":{"id":"/docs/guides/dns-setup-119","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"Field"},"6827":{"id":"/docs/guides/dns-setup-120","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"Value"},"6828":{"id":"/docs/guides/dns-setup-121","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"**Type**"},"6829":{"id":"/docs/guides/dns-setup-122","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"MX"},"6830":{"id":"/docs/guides/dns-setup-123","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"**Host/Name**"},"6831":{"id":"/docs/guides/dns-setup-124","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"`@` (or leave blank)"},"6832":{"id":"/docs/guides/dns-setup-125","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#mx-record-inbox-users","content":"**Value**"},"6833":{"id":"/docs/guides/dns-setup-126","page_id":"/docs/guides/dns-setup","ta