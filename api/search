":{"id":"/docs/api-reference/authentication-33","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"API keys can be scoped to limit their permissions:"},"240":{"id":"/docs/api-reference/authentication-34","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Scope"},"241":{"id":"/docs/api-reference/authentication-35","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Permissions"},"242":{"id":"/docs/api-reference/authentication-36","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`full_access`"},"243":{"id":"/docs/api-reference/authentication-37","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"All API operations (send, domains, templates, contacts, webhooks, analytics)"},"244":{"id":"/docs/api-reference/authentication-38","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`sending_access`"},"245":{"id":"/docs/api-reference/authentication-39","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Convenience scope for `emails:send` and `emails:read`"},"246":{"id":"/docs/api-reference/authentication-40","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`emails:send`, `emails:read`"},"247":{"id":"/docs/api-reference/authentication-41","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Send/manage submission jobs, or read email status and validate addresses"},"248":{"id":"/docs/api-reference/authentication-42","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`templates:read`, `templates:write`"},"249":{"id":"/docs/api-reference/authentication-43","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read/preview templates, or manage templates and branding"},"250":{"id":"/docs/api-reference/authentication-44","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`contacts:read`, `contacts:write`"},"251":{"id":"/docs/api-reference/authentication-45","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read/export contacts, or manage/import contacts and lists"},"252":{"id":"/docs/api-reference/authentication-46","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`domains:read`, `domains:write`"},"253":{"id":"/docs/api-reference/authentication-47","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read domains, or manage/verify domains"},"254":{"id":"/docs/api-reference/authentication-48","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`campaigns:read`, `campaigns:write`"},"255":{"id":"/docs/api-reference/authentication-49","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read campaigns, or manage campaigns; dispatch also requires `emails:send`"},"256":{"id":"/docs/api-reference/authentication-50","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`webhooks:read`, `webhooks:write`"},"257":{"id":"/docs/api-reference/authentication-51","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read webhooks, or manage/retry webhook deliveries"},"258":{"id":"/docs/api-reference/authentication-52","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`suppressions:read`, `suppressions:write`"},"259":{"id":"/docs/api-reference/authentication-53","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read or manage suppressions and preferences"},"260":{"id":"/docs/api-reference/authentication-54","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`analytics:read`, `keys:read`"},"261":{"id":"/docs/api-reference/authentication-55","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read analytics or API key metadata"},"262":{"id":"/docs/api-reference/authentication-56","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Select the narrowest scopes that meet your use case. `sending` and `read_only` are not recognized scope names. The dashboard sending preset additionally includes template/domain read scopes. API key creation, deletion and revocation require `full_access`; `keys:write` alone cannot mint broader credentials. Unclassified routes require `full_access` by default. Existing legacy keys with null/empty stored scopes retain full access for compatibility and should be reviewed explicitly."},"263":{"id":"/docs/api-reference/authentication-57","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#keys-issued-to-connectors-oauth","content":"An MCP client that speaks OAuth rather than taking a key — the claude.ai and\nClaude Desktop connectors — obtains one through the platform's authorization\nserver (`/.well-known/oauth-authorization-server`). The client registers\nitself, sends you to a NorthRelay sign-in page that names the client and\nthe address the token will go to, and you tick exactly the permissions it\ngets, starting from read-only. What is approved is an ordinary API key named\n`oauth-<client>-…`: it appears under **Settings → API Keys**, holds only the\nscopes you ticked (never `full_access` or `keys:*`), cannot authenticate to\nSMTP, expires after 30 days and is renewed by the client through a rotating\nrefresh token. Revoking it under API Keys ends the connector's access: the\nnext renewal is refused and the grant is closed. A refresh token presented\ntwice, or an authorization code presented twice, revokes the whole grant —\na stolen copy is indistinguishable from the real one until it is used\ntwice, and which holder is the thief is unknowable."},"264":{"id":"/docs/api-reference/authentication-58","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#session-authentication","content":"New passwords and password resets require at least 12 characters, an uppercase letter, a lowercase letter and a digit, with a maximum of 72 UTF-8 bytes. Existing-account login remains compatible with previously accepted passwords."},"265":{"id":"/docs/api-reference/authentication-59","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#session-authentication","content":"Dashboard endpoints also accept NextAuth.js session cookies. This is used automatically when you interact with the API from the NorthRelay dashboard. Session auth is not recommended for server-to-server integrations -- use API keys instead."},"266":{"id":"/docs/api-reference/authentication-60","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#error-responses","content":"Authentication failures return a `401` status:"},"267":{"id":"/docs/api-reference/authentication-61","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#error-responses","content":"An invalid or revoked key returns:"},"268":{"id":"/docs/api-reference/authentication-62","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Never commit API keys to version control.** Store them in environment variables or a secrets manager."},"269":{"id":"/docs/api-reference/authentication-63","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Use separate keys per environment.** Create distinct keys for production, staging, and development."},"270":{"id":"/docs/api-reference/authentication-64","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Rotate keys regularly.** Revoke and regenerate keys every 90 days or after any suspected exposure."},"271":{"id":"/docs/api-reference/authentication-65","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Use the narrowest scope.** A backend that only sends emails should use a `sending_access`- or `emails:send`-scoped key."},"272":{"id":"/docs/api-reference/authentication-66","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practi