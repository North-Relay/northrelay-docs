des/dns-setup-31","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#dns-setup-guide","content":"Properly configured DNS records are essential for email deliverability. Without them, your emails are far more likely to land in spam or be rejected outright. This guide covers the three key authentication records (SPF, DKIM, DMARC) and the optional MX record for inbox users."},"6755":{"id":"/docs/guides/dns-setup-32","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Email authentication works through DNS records that prove you authorized NorthRelay to send email on behalf of your domain. Receiving mail servers check these records to verify legitimacy."},"6756":{"id":"/docs/guides/dns-setup-33","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Record"},"6757":{"id":"/docs/guides/dns-setup-34","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Purpose"},"6758":{"id":"/docs/guides/dns-setup-35","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Required"},"6759":{"id":"/docs/guides/dns-setup-36","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**SPF**"},"6760":{"id":"/docs/guides/dns-setup-37","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Declares which servers are allowed to send email for your domain"},"6761":{"id":"/docs/guides/dns-setup-38","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Yes"},"6762":{"id":"/docs/guides/dns-setup-39","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**DKIM**"},"6763":{"id":"/docs/guides/dns-setup-40","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Adds a cryptographic signature to prove the email was not tampered with"},"6764":{"id":"/docs/guides/dns-setup-41","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Yes (auto-configured)"},"6765":{"id":"/docs/guides/dns-setup-42","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**DMARC**"},"6766":{"id":"/docs/guides/dns-setup-43","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Tells receiving servers what to do with emails that fail SPF/DKIM checks"},"6767":{"id":"/docs/guides/dns-setup-44","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Strongly recommended"},"6768":{"id":"/docs/guides/dns-setup-45","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**MX**"},"6769":{"id":"/docs/guides/dns-setup-46","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Routes inbound email to NorthRelay's mailbox servers (inbox users only)"},"6770":{"id":"/docs/guides/dns-setup-47","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Only for inbox"},"6771":{"id":"/docs/guides/dns-setup-48","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#spf-record","content":"SPF (Sender Policy Framework) tells receiving mail servers which IP addresses are authorized to send email for your domain."},"6772":{"id":"/docs/guides/dns-setup-49","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Add a TXT record at the root of your domain:"},"6773":{"id":"/docs/guides/dns-setup-50","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Field"},"6774":{"id":"/docs/guides/dns-setup-51","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Value"},"6775":{"id":"/docs/guides/dns-setup-52","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Type**"},"6776":{"id":"/docs/guides/dns-setup-53","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"TXT"},"6777":{"id":"/docs/guides/dns-setup-54","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Host/Name**"},"6778":{"id":"/docs/guides/dns-setup-55","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"`@` (or leave blank, depending on your DNS provider)"},"6779":{"id":"/docs/guides/dns-setup-56","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Value**"},"6780":{"id":"/docs/guides/dns-setup-57","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"`v=spf1 include:_spf.north-pipe.ca -all`"},"6781":{"id":"/docs/guides/dns-setup-58","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**TTL**"},"6782":{"id":"/docs/guides/dns-setup-59","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"3600 (or default)"},"6783":{"id":"/docs/guides/dns-setup-60","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#how-it-works","content":"The `include:_spf.north-pipe.ca` directive tells receiving servers to look up NorthRelay's SPF record, which lists NorthRelay's sending IPs (IPv4 and IPv6), so you never need to update SPF when our infrastructure changes. The `-all` suffix means \"reject email from any other source\" — this is the strictest and most secure setting."},"6784":{"id":"/docs/guides/dns-setup-61","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#if-you-already-have-an-spf-record","content":"A domain can only have **one** SPF TXT record. If you already send email through another provider, merge the records:"},"6785":{"id":"/docs/guides/dns-setup-62","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#if-you-already-have-an-spf-record","content":"Do not create a second TXT record starting with `v=spf1` — this will cause SPF to fail entirely."},"6786":{"id":"/docs/guides/dns-setup-63","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Using `~all` (softfail) instead of `-all` (hardfail) — softfail is weaker and may not protect you"},"6787":{"id":"/docs/guides/dns-setup-64","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Adding more than 10 DNS lookups in your SPF chain (SPF has a 10-lookup limit)"},"6788":{"id":"/docs/guides/dns-setup-65","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Creating multiple SPF records on the same domain"},"6789":{"id":"/docs/guides/dns-setup-66","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#dkim-record","content":"DKIM (DomainKeys Identified Mail) adds a cryptographic signature to each outgoing email, allowing the recipient to verify the message was not altered in transit."},"6790":{"id":"/docs/guides/dns-setup-67","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"DKIM is **automatically configured** when you verify your domain in the NorthRelay dashboard. After verification, NorthRelay publishes the DKIM public key and signs all outgoing email from your domain."},"6791":{"id":"/docs/guides/dns-setup-68","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"To verify your domain:"},"6792":{"id":"/docs/guides/dns-setup-69","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"Go to **Dashboard → Domains**"},"6793":{"id":"/docs/guides/dns-setup-70","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"Click **Add Domain** and enter your domain name"},"6794":{"id":"/docs/guides/dns-setup-71","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"Add the verification TXT record shown in the dashboard to your DNS"},"6795":{"id":"/docs/guides/dns-setup-72","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"Click **Verify**"},"6796":{"id":"/docs/guides/dns-setup-73","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#auto-configured","content":"Once verified, DKIM signing is enabled automatically"},"6797":{"id":"/docs/guides/dns-setup-74","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#verifying-dkim","content":"After domain verification, confirm the DKIM record is published:"},"6798":{"id":"/docs/guides/dns-setup-75","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#verifying-dkim","content":"You should see a response containing a `v=DKIM1; k=rsa; p=...` value. If the record is missing, wait up to 48 hours for DNS propagation, then check again."},"6799":{"id":"/docs/guides/dns-setup-76","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#subdomains","content":"DKIM signing supports subdomains automatically. If you send from `notifications@sub.yourdomain.com`, the parent domain's DKIM key will sign the email (using the `SubDomains=yes` configuration on NorthRelay's signing infrastructure)."},"6800":{"id":"/docs/guides/dns-setup-77","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#dmarc-record","content":"DMARC (Domain-based Message Authentication, Reporting, and Conformance) tells receiving servers how to handle emails that fail SPF or DKIM checks, and where to send aggregate reports."},"6801":{"id":"/docs/guides/dns-setup-78","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"Add a TXT record at `_dmarc.yourdomain.com`:"},"6802":{"id":"/docs/guides/dns-setup-79","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"Field"},"6803":{"id":"/docs/guides/dns-setup-80","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"Value"},"6804":{"id":"/docs/guides/dns-setup-81","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"**Type**"},"6805":{"id":"/docs/guides/dns-setup-82","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"TXT"},"6806":{"id":"/docs/guides/dns-setup-83","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"**Host/Name**"},"6807":{"id":"/docs/guides/dns-setup-84","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"`_dmarc`"},"6808":{"id":"/docs/guides/dns-setup-85","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"**Value**"},"6809":{"id":"/docs/guides/dns-setup-86","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"`v=DMARC1; p=quarantine; rua=mailto:dmarc@yourdomain.com`"},"6810":{"id":"/docs/guides/dns-setup-87","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"**TTL**"},"6811":{"id":"/docs/guides/dns-setup-88","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add-1","content":"3600 (or default)"},"6812":{"id":"/docs/guides/dns-setup-89","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Policy"},"6813":{"id":"/docs/guides/dns-setup-90","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Behavior"},"6814":{"id":"/docs/guides/dns-setup-91","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Recommended When"},"6815":{"id":"/docs/guides/dns-setup-92","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"`p=none`"},"6816":{"id":"/docs/guides/dns-setup-93","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Monitor only, take no action"},"6817":{"id":"/docs/guides/dns-setup-94","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Initial setup — use this while reviewing reports"},"6818":{"id":"/docs/guides/dns-setup-95","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"`p=quarantine`"},"6819":{"id":"/docs/guides/dns-setup-96","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#policy-options","content":"Send failing emails to spam"},"6820":{"id":"/docs/guides/dns-setup-97","page_id":"/docs/guides/d