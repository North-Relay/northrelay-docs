-reference/webhooks-227","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#best-practices","content":"**Use HTTPS.** Webhook URLs must use HTTPS. HTTP endpoints are rejected."},"5518":{"id":"/docs/api-reference/webhooks-228","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#best-practices","content":"**Log failures.** Monitor your webhook endpoint health in the dashboard."},"5519":{"id":"/docs/billing/faq","page_id":"/docs/billing/faq","type":"page","content":"Billing FAQ","breadcrumbs":["NorthRelay Documentation","Billing"],"tags":[],"url":"/docs/billing/faq"},"5520":{"id":"/docs/billing/faq-0","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq","content":"Frequently asked questions about NorthRelay billing, plan changes, and payments"},"5521":{"id":"/docs/billing/faq-1","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#billing-faq","content":"Billing FAQ"},"5522":{"id":"/docs/billing/faq-2","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#plan-changes","content":"Plan Changes"},"5523":{"id":"/docs/billing/faq-3","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#can-i-switch-plans-at-any-time","content":"Can I switch plans at any time?"},"5524":{"id":"/docs/billing/faq-4","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#is-my-billing-prorated-when-i-upgrade","content":"Is my billing prorated when I upgrade?"},"5525":{"id":"/docs/billing/faq-5","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#is-my-billing-prorated-when-i-downgrade","content":"Is my billing prorated when I downgrade?"},"5526":{"id":"/docs/billing/faq-6","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"What happens to my custom domains if I downgrade below Pro?"},"5527":{"id":"/docs/billing/faq-7","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happens-to-my-webhooks-if-i-downgrade-below-pro","content":"What happens to my webhooks if I downgrade below Pro?"},"5528":{"id":"/docs/billing/faq-8","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happens-to-my-team-members-if-i-downgrade-below-scale","content":"What happens to my team members if I downgrade below Scale?"},"5529":{"id":"/docs/billing/faq-9","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#quotas--limits","content":"Quotas & Limits"},"5530":{"id":"/docs/billing/faq-10","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"What happens if I exceed my monthly email quota?"},"5531":{"id":"/docs/billing/faq-11","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#do-unused-emails-roll-over-to-the-next-month","content":"Do unused emails roll over to the next month?"},"5532":{"id":"/docs/billing/faq-12","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#is-there-an-overage-option-instead-of-upgrading","content":"Is there an overage option instead of upgrading?"},"5533":{"id":"/docs/billing/faq-13","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#payments","content":"Payments"},"5534":{"id":"/docs/billing/faq-14","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-payment-methods-do-you-accept","content":"What payment methods do you accept?"},"5535":{"id":"/docs/billing/faq-15","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-currency-are-charges-in","content":"What currency are charges in?"},"5536":{"id":"/docs/billing/faq-16","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#when-am-i-charged","content":"When am I charged?"},"5537":{"id":"/docs/billing/faq-17","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-if-my-payment-fails","content":"What if my payment fails?"},"5538":{"id":"/docs/billing/faq-18","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#can-i-pay-annually","content":"Can I pay annually?"},"5539":{"id":"/docs/billing/faq-19","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#refunds","content":"Refunds"},"5540":{"id":"/docs/billing/faq-20","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-is-your-refund-policy","content":"What is your refund policy?"},"5541":{"id":"/docs/billing/faq-21","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#how-do-i-request-a-refund","content":"How do I request a refund?"},"5542":{"id":"/docs/billing/faq-22","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#free-tier","content":"Free Tier"},"5543":{"id":"/docs/billing/faq-23","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-are-the-free-tier-limitations","content":"What are the Free tier limitations?"},"5544":{"id":"/docs/billing/faq-24","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#do-i-need-a-credit-card-for-the-free-tier","content":"Do I need a credit card for the free tier?"},"5545":{"id":"/docs/billing/faq-25","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#enterprise","content":"Enterprise"},"5546":{"id":"/docs/billing/faq-26","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#how-does-enterprise-pricing-work","content":"How does Enterprise pricing work?"},"5547":{"id":"/docs/billing/faq-27","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#can-i-get-a-dedicated-ip-on-a-non-enterprise-plan","content":"Can I get a dedicated IP on a non-Enterprise plan?"},"5548":{"id":"/docs/billing/faq-28","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#do-you-offer-non-profit-or-startup-discounts","content":"Do you offer non-profit or startup discounts?"},"5549":{"id":"/docs/billing/faq-29","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#related","content":"Related"},"5550":{"id":"/docs/billing/faq-30","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#can-i-switch-plans-at-any-time","content":"Yes. You can upgrade or downgrade your plan at any time from **Dashboard > Billing > Change Plan**."},"5551":{"id":"/docs/billing/faq-31","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#can-i-switch-plans-at-any-time","content":"**Upgrades** take effect immediately. You get instant access to the new tier's features and sending limits."},"5552":{"id":"/docs/billing/faq-32","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#can-i-switch-plans-at-any-time","content":"**Downgrades** take effect at the end of your current billing cycle. You keep your current features until then."},"5553":{"id":"/docs/billing/faq-33","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#is-my-billing-prorated-when-i-upgrade","content":"Yes. When you upgrade mid-cycle, you are charged the prorated difference for the remaining days in your billing period. For example, if you upgrade from Micro ($5/mo) to Pro ($19/mo) halfway through your cycle, you pay approximately $7 for the remaining half-month."},"5554":{"id":"/docs/billing/faq-34","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#is-my-billing-prorated-when-i-downgrade","content":"No. Downgrades take effect at the end of your current billing cycle. You are not refunded for the remaining days on your current plan, but you retain full access to your current tier's features until the cycle ends."},"5555":{"id":"/docs/billing/faq-35","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"Custom domains are a Pro+ feature. If you downgrade to Micro or Free:"},"5556":{"id":"/docs/billing/faq-36","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"Your custom domains are **deactivated** (not deleted) at the end of the billing cycle"},"5557":{"id":"/docs/billing/faq-37","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"Emails will send from your NorthRelay system subdomain instead"},"5558":{"id":"/docs/billing/faq-38","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"Your domain configuration is preserved -- if you upgrade again, your domains reactivate without needing to re-verify DNS"},"5559":{"id":"/docs/billing/faq-39","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-webhooks-if-i-downgrade-below-pro","content":"Webhooks are a Pro+ feature. If you downgrade:"},"5560":{"id":"/docs/billing/faq-40","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-webhooks-if-i-downgrade-below-pro","content":"Webhook endpoints are **paused** at the end of the billing cycle"},"5561":{"id":"/docs/billing/faq-41","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-webhooks-if-i-downgrade-below-pro","content":"No events are delivered while paused"},"5562":{"id":"/docs/billing/faq-42","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-webhooks-if-i-downgrade-below-pro","content":"Webhook configurations are preserved -- upgrading reactivates them"},"5563":{"id":"/docs/billing/faq-43","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-team-members-if-i-downgrade-below-scale","content":"Team members are a Scale+ feature. If you downgrade:"},"5564":{"id":"/docs/billing/faq-44","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-team-members-if-i-downgrade-below-scale","content":"Team member access is **revoked** at the end of the billing cycle"},"5565":{"id":"/docs/billing/faq-45","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-to-my-team-members-if-i-downgrade-below-scale","content":"Team member accounts are preserved -- upgrading restores their access"},"5566":{"id":"/docs/billing/faq-46","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"When you reach your monthly sending limit:"},"5567":{"id":"/docs/billing/faq-47","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"Additional send requests return an error: `451 4.7.1 Rate limit exceeded`"},"5568":{"id":"/docs/billing/faq-48","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"The API returns a `QuotaExceededError` with a clear message"},"5569":{"id":"/docs/billing/faq-49","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"Already-queued and in-progress emails continue to deliver"},"5570":{"id":"/docs/billing/faq-50","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"Your dashboard shows a warning when you reach 80% of your quota"},"5571":{"id":"/docs/billing/faq-51","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"Your quota resets at the start of your next billing cycle"},"5572":{"id":"/docs/billing/faq-52","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-happens-if-i-exceed-my-monthly-email-quota","content":"You can upgrade your plan at any time to get a higher quota immediately."},"5573":{"id":"/docs/billing/faq-53","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#do-unused-emails-roll-over-to-the-next-month","content":"No. Email quotas reset at the start of each billing cycle. Unused emails do not carry over."},"5574":{"id":"/docs/billing/faq-54","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#is-there-an-overage-option-instead-of-upgrading","content":"Not currently. If you regularly exceed your quota, upgrading to the next tier is the recommended approach. Enterprise plans can include custom quota arrangements -- contact sales."},"5575":{"id":"/docs/billing/faq-55","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-payment-methods-do-you-accept","content":"NorthRelay accepts Visa, Mastercard, and American Express credit and debit cards. All payments are processed securely through Stripe."},"5576":{"id":"/docs/billing/faq-56","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-currency-are-charges-in","content":"All charges are in **USD** (US Dollars)."},"5577":{"id":"/docs/billing/faq-57","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#when-am-i-charged","content":"You are charged on the same day each month, based on the date you first subscribed. For example, if you signed up on March 15, you are charged on the 15th of each month."},"5578":{"id":"/docs/billing/faq-58","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"If a payment fails:"},"5579":{"id":"/docs/billing/faq-59","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"You receive an email notification"},"5580":{"id":"/docs/billing/faq-60","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"Stripe automatically retries after 3 days, then again after 5 days"},"5581":{"id":"/docs/billing/faq-61","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"If all retries fail, your account is downgraded to the Free tier"},"5582":{"id":"/docs/billing/faq-62","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"You can resolve it at any time by updating your payment method and retrying"},"5583":{"id":"/docs/billing/faq-63","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-if-my-payment-fails","content":"No data is lost during a payment failure. Your account, domains, templates, and contacts are all preserved."},"5584":{"id":"/docs/billing/faq-64","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#can-i-pay-annually","content":"Annual billing is not currently available for self-service plans. Enterprise customers can arrange annual billing -- contact sales."},"5585":{"id":"/docs/billing/faq-65","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-is-your-refund-policy","content":"NorthRelay offers a **14-day money-back guarantee** on your first payment for any paid plan. If you are not satisfied within 14 days of your first charge, contact support for a full refund."},"5586":{"id":"/docs/billing/faq-66","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-is-your-refund-policy","content":"After the 14-day window:"},"5587":{"id":"/docs/billing/faq-67","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-is-your-refund-policy","content":"Monthly charges are **not refundable** once the billing cycle has started"},"5588":{"id":"/docs/billing/faq-68","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-is-your-refund-policy","content":"Downgrades take effect at the end of the cycle (no partial refund)"},"5589":{"id":"/docs/billing/faq-69","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-is-your-refund-policy","content":"If there is a service issue on NorthRelay's end (outage, billing error), refunds or credits are handled on a case-by-case basis"},"5590":{"id":"/docs/billing/faq-70","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#how-do-i-request-a-refund","content":"Email support\\@northrelay.ca with your account email and the reason for your request. Refund requests within the 14-day window are processed within 5-10 business days."},"5591":{"id":"/docs/billing/faq-71","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-are-the-free-tier-limitations","content":"The Free tier includes:"},"5592":{"id":"/docs/billing/faq-72","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-are-the-free-tier-limitations","content":"3,000 emails per month"},"5593":{"id":"/docs/billing/faq-73","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-are-the-free-tier-limitations","content":"Shared IP pool (shared with other free and Micro tier senders)"},"5594":{"id":"/docs/billing/faq-74","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq#what-are-the-free-tier-limitations","content":"Sends from a NorthRelay system subdomain only (no custom dom