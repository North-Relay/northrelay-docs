d Suddenly"},"2526":{"id":"/docs/features/reputation-monitoring-21","page_id":"/docs/features/reputation-monitoring","type":"heading","tags":[],"url":"/docs/features/reputation-monitoring#best-practices","content":"Best Practices"},"2527":{"id":"/docs/features/reputation-monitoring-22","page_id":"/docs/features/reputation-monitoring","type":"heading","tags":[],"url":"/docs/features/reputation-monitoring#related","content":"Related"},"2528":{"id":"/docs/features/reputation-monitoring-23","page_id":"/docs/features/reputation-monitoring","tags":[],"type":"text","url":"/docs/features/reputation-monitoring#reputation-monitoring","content":"NorthRelay continuously monitors your sender reputation and automatically detects delivery issues. Your reputation score directly affects whether your emails land in the inbox or get filtered to spam."},"2529":{"id":"/docs/features/reputation-monitoring-24","page_id":"/docs/features/reputation-monitoring","tags":[],"type":"text","url":"/docs/features/reputation-monitoring#understanding-sender-reputation","content":"Every email you send contributes to your sender reputation -- a score that mailbox providers (Gmail, Outlook, Yahoo, etc.) use to decide whether to accept, filter, or reject your messages. NorthRelay tracks this internally and provides a real-time view in your dashboard."},"2530":{"id":"/docs/features/reputation-monitoring-25","page_id":"/docs/features/reputation-monitoring","tags":[],"type":"text","url":"/docs/features/reputation-monitoring#understanding-sender-reputation","content":"A high reputation means:"},"2531":{"id":"/docs/features/reputation-monitoring-26","page_id":"/docs/features/reputation-monitoring","tags":[],"type":"text","url":"/docs/features/reputation-monitoring#understanding-sender-reputation","content":"Better inbox placement rates"},"2532":{"id":"/docs/features/reputation-monitoring-27","page_id":"/docs/features/reputation-monitoring","tags":[],"type":"text","url":"/docs/features/reputation-monitoring#un