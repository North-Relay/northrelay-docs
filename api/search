/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Bearer token(s) callers must present; comma-separate several to rotate without a gap"},"7953":{"id":"/docs/sdks/mcp-server-55","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`NORTHRELAY_MCP_PORT`"},"7954":{"id":"/docs/sdks/mcp-server-56","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"No"},"7955":{"id":"/docs/sdks/mcp-server-57","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`3010`"},"7956":{"id":"/docs/sdks/mcp-server-58","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Port for hosted mode (`--port` wins)"},"7957":{"id":"/docs/sdks/mcp-server-59","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`NORTHRELAY_MCP_BIND`"},"7958":{"id":"/docs/sdks/mcp-server-60","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"No"},"7959":{"id":"/docs/sdks/mcp-server-61","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`127.0.0.1`"},"7960":{"id":"/docs/sdks/mcp-server-62","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Interface for hosted mode (`--bind` wins)"},"7961":{"id":"/docs/sdks/mcp-server-63","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`NORTHRELAY_MCP_SESSION_TTL_MS`"},"7962":{"id":"/docs/sdks/mcp-server-64","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"No"},"7963":{"id":"/docs/sdks/mcp-server-65","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"`600000`"},"7964":{"id":"/docs/sdks/mcp-server-66","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Close a hosted session left idle this long"},"7965":{"id":"/docs/sdks/mcp-server-67","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Keep the API key and the bearer token out of files you commit or text you\npaste. Where a client can read a secret from the environment, the examples\nbelow do that."},"7966":{"id":"/docs/sdks/mcp-server-68","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"Over stdio, with the API key passed through `--env`:"},"7967":{"id":"/docs/sdks/mcp-server-69","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"Against a hosted endpoint, with the bearer as a header (`--scope user` makes\nit available in every project):"},"7968":{"id":"/docs/sdks/mcp-server-70","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"In a project's checked-in `.mcp.json`, write the placeholder and Claude Code\nexpands it from the environment when it loads:"},"7969":{"id":"/docs/sdks/mcp-server-71","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"`claude mcp list`, or `/mcp` inside a session, shows whether it connected."},"7970":{"id":"/docs/sdks/mcp-server-72","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"The Codex CLI, IDE extension and desktop app share `~/.codex/config.toml`\n(or a project's `.codex/config.toml`)."},"7971":{"id":"/docs/sdks/mcp-server-73","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"Over stdio:"},"7972":{"id":"/docs/sdks/mcp-server-74","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"which writes:"},"7973":{"id":"/docs/sdks/mcp-server-75","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"Against a hosted endpoint, name the environment variable that holds the\nbearer — the file itself never contains it:"},"7974":{"id":"/docs/sdks/mcp-server-76","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Add the following to your Claude Desktop configuration file:"},"7975":{"id":"/docs/sdks/mcp-server-77","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"**macOS:** `~/Library/Application Support/Claude/claude_desktop_config.json`\n**Windows:** `%APPDATA%\\Claude\\claude_desktop_config.json`\n**Linux:** `~/.config/Claude/claude_desktop_config.json`"},"7976":{"id":"/docs/sdks/mcp-server-78","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Restart Claude Desktop after saving the configuration."},"7977":{"id":"/docs/sdks/mcp-server-79","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"**claude.ai and Claude Desktop custom connectors.** The *Add custom\nconnector* dialog reaches a remote MCP server and authenticates by OAuth —\nthere is no field for a bearer token. A hosted instance running in\nconnector mode is what it needs:"},"7978":{"id":"/docs/sdks/mcp-server-80","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Settings → Connectors → *Add custom connector*, with the endpoint URL\n(`https://mcp.example.net/mcp`), no client id and no secret."},"7979":{"id":"/docs/sdks/mcp-server-81","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"A NorthRelay sign-in page opens. It names the client that is asking and\nthe address the token will be sent to, and starts from read-only\npermissions; tick exactly what the connector should be able to do."},"7980":{"id":"/docs/sdks/mcp-server-82","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Approving issues an API key named `oauth-<client>-…`. It appears under\n**Settings → API Keys**, expires after 30 days (the connector renews it\nitself), and revoking it there ends the connector's access."},"7981":{"id":"/docs/sdks/mcp-server-83","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"A hosted instance that serves only a shared token cannot be added as a\nconnector; use Claude Code or Codex for that one."},"7982":{"id":"/docs/sdks/mcp-server-84","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"In Cursor settings, add an MCP server with:"},"7983":{"id":"/docs/sdks/mcp-server-85","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Name:** `northrelay`"},"7984":{"id":"/docs/sdks/mcp-server-86","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Command:** `npx @northrelay/mcp-server`"},"7985":{"id":"/docs/sdks/mcp-server-87","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Environment:** `NORTHRELAY_API_KEY=nr_live_your_api_key_here`"},"7986":{"id":"/docs/sdks/mcp-server-88","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#windsurf","content":"Add to your Windsurf MCP configuration:"},"7987":{"id":"/docs/sdks/mcp-server-89","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"By default the server speaks stdio and each client spawns its own copy. Pass\n`--http` to serve Streamable HTTP instead, so a team, a CI job, or an agent\nrunning elsewhere can share one instance without holding the API key:"},"7988":{"id":"/docs/sdks/mcp-server-90","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"The MCP endpoint is `/mcp`; `GET /healthz` is an unauthenticated probe."},"7989":{"id":"/docs/sdks/mcp-server-91","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"A bearer token is **required**. The endpoint can send real mail, rewrite\ntemplates and clear suppressions, so the server refuses to start without\n`NORTHRELAY_MCP_AUTH_TOKEN` and answers `401` to a wrong one. Every caller\npresents `Authorization: Bearer <token>`."},"7990":{"id":"/docs/sdks/mcp-server-92","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"It binds `127.0.0.1` by default. Put it behind a reverse proxy that\nterminates TLS rather than exposing the port directly."},"7991":{"id":"/docs/sdks/mcp-server-93","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"A session idle past `NORTHRELAY_MCP_SESSION_TTL_MS` is closed, so a client\nthat crashes without ending its session is not held forever."},"7992":{"id":"/docs/sdks/mcp-server-94","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"To check an endpoint from a client machine:"},"7993":{"id":"/docs/sdks/mcp-server-95","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Set `NORTHRELAY_MCP_PUBLIC_URL` to the origin the instance is reached at,\nand a caller may present its **own** NorthRelay API key as the bearer\ninstead of the shared token:"},"7994":{"id":"/docs/sdks/mcp-server-96","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Each session then acts as the key it presented — scoped and revocable in\nthat account's key list — and the process needs no `NORTHRELAY_API_KEY` of\nits own unless it also serves a shared token. The server publishes\n`/.well-known/oauth-protected-resource` naming the NorthRelay platform as\nits authorization server, which is how the claude.ai and Claude Desktop\nconnectors find their way to the sign-in page. A key is checked with the\nplatform once, when a session opens; a revoked key is refused at the next\nsession."},"7995":{"id":"/docs/sdks/mcp-server-97","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Variable"},"7996":{"id":"/docs/sdks/mcp-server-98","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Description"},"7997":{"id":"/docs/sdks/mcp-server-99","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"`NORTHRELAY_MCP_PUBLIC_URL`"},"7998":{"id":"/docs/sdks/mcp-server-100","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"This endpoint's public origin, `https://` (or `http://localhost` for a local instance), no path"},"7999":{"id":"/docs/sdks/mcp-server-101","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"The platform side needs nothing configured: every NorthRelay account can\napprove connectors, and `OAUTH_CONNECTORS_DISABLED=true` on the platform\nswitches the authorization server off."},"8000":{"id":"/docs/sdks/mcp-server-102","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#tool-gr