ls` field"},"6119":{"id":"/docs/api-reference/webhooks-211","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"Description"},"6120":{"id":"/docs/api-reference/webhooks-212","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"`email`"},"6121":{"id":"/docs/api-reference/webhooks-213","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"Recipient address"},"6122":{"id":"/docs/api-reference/webhooks-214","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"`contactId`, `campaignId`"},"6123":{"id":"/docs/api-reference/webhooks-215","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"Set for campaign mail"},"6124":{"id":"/docs/api-reference/webhooks-216","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"`trackingId`"},"6125":{"id":"/docs/api-reference/webhooks-217","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"Set for API mail: the tracking id of the sent message"},"6126":{"id":"/docs/api-reference/webhooks-218","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"`url`"},"6127":{"id":"/docs/api-reference/webhooks-219","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#emailopened-and-emailclicked","content":"The clicked link (`email.clicked` only)"},"6128":{"id":"/docs/api-reference/webhooks-220","page_id":"/d