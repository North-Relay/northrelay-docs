docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#sending-emails","content":"Sending Emails"},"8906":{"id":"/docs/sdks/mcp-server-16","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#managing-templates","content":"Managing Templates"},"8907":{"id":"/docs/sdks/mcp-server-17","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#checking-delivery-status","content":"Checking Delivery Status"},"8908":{"id":"/docs/sdks/mcp-server-18","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#deliverability-checks","content":"Deliverability Checks"},"8909":{"id":"/docs/sdks/mcp-server-19","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#campaign-management","content":"Campaign Management"},"8910":{"id":"/docs/sdks/mcp-server-20","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#mailing-lists-and-subscriptions","content":"Mailing Lists and Subscriptions"},"8911":{"id":"/docs/sdks/mcp-server-21","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#troubleshooting","content":"Troubleshooting"},"8912":{"id":"/docs/sdks/mcp-server-22","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#server-not-starting","content":"Server Not Starting"},"8913":{"id":"/docs/sdks/mcp-server-23","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#tools-not-appearing-in-ai-client","content":"Tools Not Appearing in AI Client"},"8914":{"id":"/docs/sdks/mcp-server-24","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#authentication-errors","content":"Authentication Errors"},"8915":{"id":"/docs/sdks/mcp-server-25","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#hosted-endpoint-connects-but-shows-no-tools","content":"Hosted Endpoint Connects But Shows No Tools"},"8916":{"id":"/docs/sdks/mcp-server-26","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#related","content":"Related"},"8917":{"id":"/docs/sdks/mcp-server-27","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#mcp-server","content":"The NorthRelay MCP Server (`@northrelay/mcp-server` 1.9.0) exposes the full NorthRelay API as tools that AI agents can use directly. It implements the Model Context Protocol (MCP) standard, allowing AI assistants to send emails, manage templates, check delivery status, and more through natural language."},"8918":{"id":"/docs/sdks/mcp-server-28","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"The Model Context Protocol (MCP) is an open standard that lets AI applications interact with external services through structured tool calls. Instead of writing code, you describe what you want in plain language, and the AI agent calls the appropriate NorthRelay tools on your behalf."},"8919":{"id":"/docs/sdks/mcp-server-29","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"**Supported AI clients:**"},"8920":{"id":"/docs/sdks/mcp-server-30","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Claude Code"},"8921":{"id":"/docs/sdks/mcp-server-31","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Claude Desktop"},"8922":{"id":"/docs/sdks/mcp-server-32","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Codex (CLI, IDE extension and desktop app)"},"8923":{"id":"/docs/sdks/mcp-server-33","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Cursor"},"8924":{"id":"/docs/sdks/mcp-server-34","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Windsurf"},"8925":{"id":"/docs/sdks/mcp-server-35","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Any MCP-compatible client"},"8926":{"id":"/docs/sdks/mcp-server-36","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"The server runs in one of two modes. Over **stdio** the client starts it\nlocally and gives it your NorthRelay API key. In **hosted (HTTP)** mode one\nrunning instance serves a team over the network, callers present a bearer\ntoken, and the API key stays on the host. See Hosted mode."},"8927":{"id":"/docs/sdks/mcp-server-37","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#installation","content":"No separate installation is needed. The server runs via `npx`:"},"8928":{"id":"/docs/sdks/mcp-server-38","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#installation","content":"Or install globally:"},"8929":{"id":"/docs/sdks/mcp-server-39","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Variable"},"8930":{"id":"/docs/sdks/mcp-server-40","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Required"},"8931":{"id":"/docs/sdks/mcp-server-41","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Default"},"8932":{"id":"/docs/sdks/mcp-server-42","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Description"},"8933":{"id":"/docs/sdks/mcp-server-43","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables