must use HTTPS. HTTP endpoints are rejected."},"5525":{"id":"/docs/api-reference/webhooks-229","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#best-practices","content":"**Log failures.** Monitor your webhook endpoint health in the dashboard."},"5526":{"id":"/docs/billing/faq","page_id":"/docs/billing/faq","type":"page","content":"Billing FAQ","breadcrumbs":["NorthRelay Documentation","Billing"],"tags":[],"url":"/docs/billing/faq"},"5527":{"id":"/docs/billing/faq-0","page_id":"/docs/billing/faq","tags":[],"type":"text","url":"/docs/billing/faq","content":"Frequently asked questions about NorthRelay billing, plan changes, and payments"},"5528":{"id":"/docs/billing/faq-1","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#billing-faq","content":"Billing FAQ"},"5529":{"id":"/docs/billing/faq-2","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#plan-changes","content":"Plan Changes"},"5530":{"id":"/docs/billing/faq-3","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#can-i-switch-plans-at-any-time","content":"Can I switch plans at any time?"},"5531":{"id":"/docs/billing/faq-4","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#is-my-billing-prorated-when-i-upgrade","content":"Is my billing prorated when I upgrade?"},"5532":{"id":"/docs/billing/faq-5","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#is-my-billing-prorated-when-i-downgrade","content":"Is my billing prorated when I downgrade?"},"5533":{"id":"/docs/billing/faq-6","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happens-to-my-custom-domains-if-i-downgrade-below-pro","content":"What happens to my custom domains if I downgrade below Pro?"},"5534":{"id":"/docs/billing/faq-7","page_id":"/docs/billing/faq","type":"heading","tags":[],"url":"/docs/billing/faq#what-happe