ooks#verification-algorithm","content":"Compare the computed signature with the header value using a timing-safe comparison"},"5507":{"id":"/docs/api-reference/webhooks-211","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"If your endpoint does not respond with a `2xx` status code within 10 seconds, NorthRelay retries the delivery:"},"5508":{"id":"/docs/api-reference/webhooks-212","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"Attempt"},"5509":{"id":"/docs/api-reference/webhooks-213","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"Delay"},"5510":{"id":"/docs/api-reference/webhooks-214","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"1st retry"},"5511":{"id":"/docs/api-reference/webhooks-215","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"30 seconds"},"5512":{"id":"/docs/api-reference/webhooks-216","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"2nd retry"},"5513":{"id":"/docs/api-reference/webhooks-217","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"2 minutes"},"5514":{"id":"/docs/api-reference/webhooks-218","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"3rd retry"},"5515":{"id":"/docs/api-reference/webhooks-219","page_id":"/docs/api-reference/webhooks","tags":[],"type":"text","url":"/docs/api-reference/webhooks#retry-policy","content":"15 minutes"},"5516":{"id":"/docs/api-reference/webhooks-220","page_id":"/docs/api-reference/webhooks","tags":[],"typ