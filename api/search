api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#security-best-practices","content":"Security Best Practices"},"180":{"id":"/docs/api-reference/authentication-12","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#authentication","content":"Most NorthRelay API requests require authentication; tracking and signed unsubscribe endpoints have separate public access rules. The primary API method is Bearer authentication using API keys. Inactive, revoked and expired keys are rejected. Use the narrowest scope supported by the endpoint and rotate keys after exposure."},"181":{"id":"/docs/api-reference/authentication-13","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#authentication","content":"API keys require an active, verified account and grant access to that account's supported tenant APIs. Administrative actions require a dashboard session with recent MFA; an administrator's personal API key does not grant administrative privileges. Signing out revokes the dashboard session, and password/security changes require a fresh sign-in."},"182":{"id":"/docs/api-reference/authentication-14","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"NorthRelay issues two types of API keys, distinguished by prefix:"},"183":{"id":"/docs/api-reference/authentication-15","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Prefix"},"184":{"id":"/docs/api-reference/authentication-16","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Environment"},"185":{"id":"/docs/api-reference/authentication-17","page_id":"/docs/api-reference/authentication","tags":[],