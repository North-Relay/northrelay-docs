g-started/introduction-1","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#introduction-to-northrelay","content":"Introduction to NorthRelay"},"2809":{"id":"/docs/getting-started/introduction-2","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#overview","content":"Overview"},"2810":{"id":"/docs/getting-started/introduction-3","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#the-problem-with-unpoliced-shared-ips","content":"The problem with unpoliced shared IPs"},"2811":{"id":"/docs/getting-started/introduction-4","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"How NorthRelay Solves It"},"2812":{"id":"/docs/getting-started/introduction-5","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#key-features","content":"Key Features"},"2813":{"id":"/docs/getting-started/introduction-6","page_id":"/docs/getting-started/introduction","type":"heading","tags":[],"url":"/docs/getting-started/introduction#next-steps","content":"Next Steps"},"2814":{"id":"/docs/getting-started/introduction-7","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#introduction-to-northrelay","content":"> What is NorthRelay and why should you use it?"},"2815":{"id":"/docs/getting-started/introduction-8","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#overview","content":"NorthRelay is a **sovereign SMTP infrastructure** designed for developers who need reliable email delivery with a sending reputation we actively protect."},"2816":{"id":"/docs/getting-started/introduction-9","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#the-problem-with-unpoliced-shared-ips","content":"Most email services put thousands of senders on the same IP addresses and let anyone send from any address. If one of them sends spam or gets blacklisted, **your emails suffer too** - your legitimate business email ends up in spam folders because of someone else's bad behavior."},"2817":{"id":"/docs/getting-started/introduction-10","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#the-problem-with-unpoliced-shared-ips","content":"A sending IP is only as trustworthy as the least careful sender allowed on it. The fix is not to hide you on a different IP - it is to make sure nobody on the IP can behave badly."},"2818":{"id":"/docs/getting-started/introduction-11","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"Every NorthRelay message leaves from **one protected sending IP**, and we treat its reputation as our job:"},"2819":{"id":"/docs/getting-started/introduction-12","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"**Verified senders only** - you can only send from domains you have verified, so nobody can spoof a domain they don't own"},"2820":{"id":"/docs/getting-started/introduction-13","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"**Automatic hygiene** - one-click unsubscribe on every campaign, plus automatic bounce and complaint suppression"},"2821":{"id":"/docs/getting-started/introduction-14","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"**Monitored every hour** - a delivery canary confirms mail is arriving with SPF, DKIM and DMARC passing"},"2822":{"id":"/docs/getting-started/introduction-15","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#how-northrelay-solves-it","content":"Plans differ by quota and features, never by IP. See Sending Infrastructure for details."},"2823":{"id":"/docs/getting-started/introduction-16","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#key-features","content":"🚀 **Quick Setup** - Send emails in under 5 minutes"},"2824":{"id":"/docs/getting-started/introduction-17","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#key-features","content":"🛡️ **Protected Sending IP** - Verified senders only, monitored every hour"},"2825":{"id":"/docs/getting-started/introduction-18","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#key-features","content":"🔧 **Self-Service Tools** - Pre-Flight Check, Blocklist Monitor, Connectivity Doctor"},"2826":{"id":"/docs/getting-started/introduction-19","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#key-features","content":"📊 **Real-Time Analytics** - See delivery status, bounces, and reputation scores"},"2827":{"id":"/docs/getting-started/introduction-20","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#key-features","content":"🔐 **Enterprise Security** - TLS encryption, DKIM signing, DMARC compliance"},"2828":{"id":"/docs/getting-started/introduction-21","page_id":"/docs/getting-started/introduction","tags":[],"type":"text","url":"/docs/getting-started/introduction#next-steps","content":"Installation Guide"},"2829":{"id":"/docs/getting-started/introduction-22","page_id":"/docs/getting-started/introduction"