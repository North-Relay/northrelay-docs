reference/authentication","type":"page","content":"Authentication","breadcrumbs":["NorthRelay Documentation","API Reference"],"tags":[],"url":"/docs/api-reference/authentication"},"168":{"id":"/docs/api-reference/authentication-0","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication","content":"How to create, manage, and use NorthRelay API keys for authenticating requests."},"169":{"id":"/docs/api-reference/authentication-1","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#authentication","content":"Authentication"},"170":{"id":"/docs/api-reference/authentication-2","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#api-key-formats","content":"API Key Formats"},"171":{"id":"/docs/api-reference/authentication-3","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#creating-an-api-key","content":"Creating an API Key"},"172":{"id":"/docs/api-reference/authentication-4","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#using-your-api-key","content":"Using Your API Key"},"173":{"id":"/docs/api-reference/authentication-5","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#nodejs-fetch","content":"Node.js (fetch)"},"174":{"id":"/docs/api-reference/authentication-6","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#python-requests","content":"Python (requests)"},"175":{"id":"/docs/api-reference/authentication-7","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#key-scopes","content":"Key Scopes"},"176":{"id":"/docs/api-reference/authentication-8","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#keys-issued-to-connectors-oauth","content":"Keys Issued to Connectors (OAuth)"},"177":{"id":"/docs/api-reference/authentication-9","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#session-authentication","content":"Session Authentication"},"178":{"id":"/docs/api-reference/authentication-10","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#error-responses","content":"Error Responses"},"179":{"id":"/docs/api-reference/authentication-11","page_id":"/docs/api-reference/authentication","type":"heading","tags":[],"url":"/docs/api-reference/authentication#security-best-practices","content":"Security Best Practices"},"180":{"id":"/docs/api-reference/authentication-12","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#authentication","content":"Most NorthRelay API requests require authentication; tracking and signed unsubscribe endpoints have separate public access rules. The primary API method is Bearer authentication using API keys. Inactive, revoked and expired keys are rejected. Use the narrowest scope supported by the endpoint and rotate keys after exposure."},"181":{"id":"/docs/api-reference/authentication-13","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#authentication","content":"API keys require an active, verified account and grant access to that account's supported tenant APIs. Administrative actions require a dashboard session with recent MFA; an administrator's personal API key does not grant administrative privileges. Signing out revokes the dashboard session, and password/security changes require a fresh sign-in."},"182":{"id":"/docs/api-reference/authentication-14","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"NorthRelay issues two types of API keys, distinguished by prefix:"},"183":{"id":"/docs/api-reference/authentication-15","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Prefix"},"184":{"id":"/docs/api-reference/authentication-16","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Environment"},"185":{"id":"/docs/api-reference/authentication-17","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Behavior"},"186":{"id":"/docs/api-reference/authentication-18","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"`nr_live_`"},"187":{"id":"/docs/api-reference/authentication-19","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Production"},"188":{"id":"/docs/api-reference/authentication-20","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Sends real emails"},"189":{"id":"/docs/api-reference/authentication-21","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"`nr_test_`"},"190":{"id":"/docs/api-reference/authentication-22","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Accepted legacy prefix"},"191":{"id":"/docs/api-reference/authentication-23","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"The prefix alone does not provide sandbox isolation"},"192":{"id":"/docs/api-reference/authentication-24","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#api-key-formats","content":"Both prefixes use the same validator. A prefix alone does not prevent real delivery or quota consumption. Use an isolated test environment and a mail sink for integration tests."},"193":{"id":"/docs/api-reference/authentication-25","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Navigate to **Dashboard > Settings > API Keys**"},"194":{"id":"/docs/api-reference/authentication-26","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Click **Create API Key**"},"195":{"id":"/docs/api-reference/authentication-27","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Enter a descriptive name (e.g., \"Production Backend\", \"Staging CI\")"},"196":{"id":"/docs/api-reference/authentication-28","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Select the key scope (see Key Scopes below)"},"197":{"id":"/docs/api-reference/authentication-29","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Click **Generate**"},"198":{"id":"/docs/api-reference/authentication-30","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"Copy the key immediately -- it is shown only once"},"199":{"id":"/docs/api-reference/authentication-31","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#creating-an-api-key","content":"The key is a long random string prefixed with `nr_live_` or `nr_test_`:"},"200":{"id":"/docs/api-reference/authentication-32","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#using-your-api-key","content":"Include the key in the `Authorization` header as a Bearer token:"},"201":{"id":"/docs/api-reference/authentication-33","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"API keys can be scoped to limit their permissions:"},"202":{"id":"/docs/api-reference/authentication-34","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Scope"},"203":{"id":"/docs/api-reference/authentication-35","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Permissions"},"204":{"id":"/docs/api-reference/authentication-36","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`full_access`"},"205":{"id":"/docs/api-reference/authentication-37","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"All API operations (send, domains, templates, contacts, webhooks, analytics)"},"206":{"id":"/docs/api-reference/authentication-38","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`sending_access`"},"207":{"id":"/docs/api-reference/authentication-39","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Convenience scope for `emails:send` and `emails:read`"},"208":{"id":"/docs/api-reference/authentication-40","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`emails:send`, `emails:read`"},"209":{"id":"/docs/api-reference/authentication-41","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Send/manage submission jobs, or read email status and validate addresses"},"210":{"id":"/docs/api-reference/authentication-42","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`templates:read`, `templates:write`"},"211":{"id":"/docs/api-reference/authentication-43","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read/preview templates, or manage templates and branding"},"212":{"id":"/docs/api-reference/authentication-44","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`contacts:read`, `contacts:write`"},"213":{"id":"/docs/api-reference/authentication-45","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read/export contacts and subscription status, or manage/import contacts, lists, subscriptions and signup forms"},"214":{"id":"/docs/api-reference/authentication-46","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`domains:read`, `domains:write`"},"215":{"id":"/docs/api-reference/authentication-47","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read domains, or manage/verify domains"},"216":{"id":"/docs/api-reference/authentication-48","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`campaigns:read`, `campaigns:write`"},"217":{"id":"/docs/api-reference/authentication-49","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read campaigns, or manage campaigns; dispatch also requires `emails:send`"},"218":{"id":"/docs/api-reference/authentication-50","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`webhooks:read`, `webhooks:write`"},"219":{"id":"/docs/api-reference/authentication-51","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read webhooks, or manage/retry webhook deliveries"},"220":{"id":"/docs/api-reference/authentication-52","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`suppressions:read`, `suppressions:write`"},"221":{"id":"/docs/api-reference/authentication-53","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read or manage suppressions and preferences"},"222":{"id":"/docs/api-reference/authentication-54","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"`analytics:read`, `keys:read`"},"223":{"id":"/docs/api-reference/authentication-55","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Read analytics or API key metadata"},"224":{"id":"/docs/api-reference/authentication-56","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#key-scopes","content":"Select the narrowest scopes that meet your use case. `sending` and `read_only` are not recognized scope names. The dashboard sending preset additionally includes template/domain read scopes. API key creation, deletion and revocation require `full_access`; `keys:write` alone cannot mint broader credentials. Unclassified routes require `full_access` by default. Existing legacy keys with null/empty stored scopes retain full access for compatibility and should be reviewed explicitly."},"225":{"id":"/docs/api-reference/authentication-57","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#keys-issued-to-connectors-oauth","content":"An MCP client that speaks OAuth rather than taking a key — the claude.ai and\nClaude Desktop connectors — obtains one through the platform's authorization\nserver (`/.well-known/oauth-authorization-server`). The client registers\nitself, sends you to a NorthRelay sign-in page that names the client and\nthe address the token will go to, and you tick exactly the permissions it\ngets, starting from read-only. What is approved is an ordinary API key named\n`oauth-<client>-…`: it appears under **Settings → API Keys**, holds only the\nscopes you ticked (never `full_access` or `keys:*`), cannot authenticate to\nSMTP, expires after 30 days and is renewed by the client through a rotating\nrefresh token. Revoking it under API Keys ends the connector's access: the\nnext renewal is refused and the grant is closed. A refresh token presented\ntwice, or an authorization code presented twice, revokes the whole grant —\na stolen copy is indistinguishable from the real one until it is used\ntwice, and which holder is the thief is unknowable."},"226":{"id":"/docs/api-reference/authentication-58","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#session-authentication","content":"New passwords and password resets require at least 12 characters, an uppercase letter, a lowercase letter and a digit, with a maximum of 72 UTF-8 bytes. Existing-account login remains compatible with previously accepted passwords."},"227":{"id":"/docs/api-reference/authentication-59","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#session-authentication","content":"Dashboard endpoints also accept NextAuth.js session cookies. This is used automatically when you interact with the API from the NorthRelay dashboard. Session auth is not recommended for server-to-server integrations -- use API keys instead."},"228":{"id":"/docs/api-reference/authentication-60","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#error-responses","content":"Authentication failures return a `401` status:"},"229":{"id":"/docs/api-reference/authentication-61","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#error-responses","content":"An invalid or revoked key returns:"},"230":{"id":"/docs/api-reference/authentication-62","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Never commit API keys to version control.** Store them in environment variables or a secrets manager."},"231":{"id":"/docs/api-reference/authentication-63","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Use separate keys per environment.** Create distinct keys for production, staging, and development."},"232":{"id":"/docs/api-reference/authentication-64","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Rotate keys regularly.** Revoke and regenerate keys every 90 days or after any suspected exposure."},"233":{"id":"/docs/api-reference/authentication-65","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Use the narrowest scope.** A backend that only sends emails should use a `sending_access`- or `emails:send`-scoped key."},"234":{"id":"/docs/api-reference/authentication-66","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Use `nr_test_` keys for development.** Avoid consuming production quota or accidentally sending real emails during testing."},"235":{"id":"/docs/api-reference/authentication-67","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Restrict server-side only.** Never expose API keys in client-side JavaScript, mobile apps, or public repositories."},"236":{"id":"/docs/api-reference/authentication-68","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Monitor key usage.** Review API key activity in Dashboard > Settings > API Keys to detect unauthorized use."},"237":{"id":"/docs/api-reference/authentication-69","page_id":"/docs/api-reference/authentication","tags":[],"type":"text","url":"/docs/api-reference/authentication#security-best-practices","content":"**Revoke compromised keys immediately.** If a key is leaked, revoke it in the dashboard and generate a replacement."},"238":{"id":"/docs/api-reference/contacts","page_id":"/docs/api-reference/contacts","type":"page","content":"Contacts API","breadcrumbs":["NorthRelay Documentation","API Reference"],"tags":[],"url":"/docs/api-reference/contacts"},"239":{"id":"/docs/api-reference/contacts-0","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts","content":"Manage contacts, conta