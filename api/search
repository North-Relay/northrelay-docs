/guides/dns-setup#using-nslookup-windows","content":"Using nslookup (Windows)"},"7505":{"id":"/docs/guides/dns-setup-20","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#using-the-dashboard","content":"Using the Dashboard"},"7506":{"id":"/docs/guides/dns-setup-21","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#dns-provider-examples","content":"DNS Provider Examples"},"7507":{"id":"/docs/guides/dns-setup-22","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#cloudflare","content":"Cloudflare"},"7508":{"id":"/docs/guides/dns-setup-23","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#amazon-route-53","content":"Amazon Route 53"},"7509":{"id":"/docs/guides/dns-setup-24","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#godaddy","content":"GoDaddy"},"7510":{"id":"/docs/guides/dns-setup-25","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#troubleshooting","content":"Troubleshooting"},"7511":{"id":"/docs/guides/dns-setup-26","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#dns-propagation-delays","content":"DNS propagation delays"},"7512":{"id":"/docs/guides/dns-setup-27","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#conflicting-spf-records","content":"Conflicting SPF records"},"7513":{"id":"/docs/guides/dns-setup-28","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#too-many-dns-lookups-spf-error","content":"\"Too many DNS lookups\" SPF error"},"7514":{"id":"/docs/guides/dns-setup-29","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#dkim-record-not-found","content":"DKIM record not found"},"7515":{"id":"/docs/guides/dns-setup-30","page_id":"/docs/guides/dns-setup","type":"heading","tags":[],"url":"/docs/guides/dns-setup#dmarc-reports-not-arriving","content":"DMARC reports not arriving"},"7516":{"id":"/docs/guides/dns-setup-31","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#dns-setup-guide","content":"Properly configured DNS records are essential for email deliverability. Without them, your emails are far more likely to land in spam or be rejected outright. This guide covers the three key authentication records (SPF, DKIM, DMARC) and the optional MX record for inbox users."},"7517":{"id":"/docs/guides/dns-setup-32","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Email authentication works through DNS records that prove you authorized NorthRelay to send email on behalf of your domain. Receiving mail servers check these records to verify legitimacy."},"7518":{"id":"/docs/guides/dns-setup-33","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Record"},"7519":{"id":"/docs/guides/dns-setup-34","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Purpose"},"7520":{"id":"/docs/guides/dns-setup-35","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Required"},"7521":{"id":"/docs/guides/dns-setup-36","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**SPF**"},"7522":{"id":"/docs/guides/dns-setup-37","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Declares which servers are allowed to send email for your domain"},"7523":{"id":"/docs/guides/dns-setup-38","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Yes"},"7524":{"id":"/docs/guides/dns-setup-39","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**DKIM**"},"7525":{"id":"/docs/guides/dns-setup-40","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Adds a cryptographic signature to prove the email was not tampered with"},"7526":{"id":"/docs/guides/dns-setup-41","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Yes (auto-configured)"},"7527":{"id":"/docs/guides/dns-setup-42","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**DMARC**"},"7528":{"id":"/docs/guides/dns-setup-43","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Tells receiving servers what to do with emails that fail SPF/DKIM checks"},"7529":{"id":"/docs/guides/dns-setup-44","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Strongly recommended"},"7530":{"id":"/docs/guides/dns-setup-45","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"**MX**"},"7531":{"id":"/docs/guides/dns-setup-46","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Routes inbound email to NorthRelay's mailbox servers (inbox users only)"},"7532":{"id":"/docs/guides/dns-setup-47","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#overview","content":"Only for inbox"},"7533":{"id":"/docs/guides/dns-setup-48","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#spf-record","content":"SPF (Sender Policy Framework) tells receiving mail servers which IP addresses are authorized to send email for your domain."},"7534":{"id":"/docs/guides/dns-setup-49","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Add a TXT record at the root of your domain:"},"7535":{"id":"/docs/guides/dns-setup-50","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Field"},"7536":{"id":"/docs/guides/dns-setup-51","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"Value"},"7537":{"id":"/docs/guides/dns-setup-52","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Type**"},"7538":{"id":"/docs/guides/dns-setup-53","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"TXT"},"7539":{"id":"/docs/guides/dns-setup-54","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Host/Name**"},"7540":{"id":"/docs/guides/dns-setup-55","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"`@` (or leave blank, depending on your DNS provider)"},"7541":{"id":"/docs/guides/dns-setup-56","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**Value**"},"7542":{"id":"/docs/guides/dns-setup-57","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"`v=spf1 include:_spf.north-pipe.ca -all`"},"7543":{"id":"/docs/guides/dns-setup-58","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"**TTL**"},"7544":{"id":"/docs/guides/dns-setup-59","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#what-to-add","content":"3600 (or default)"},"7545":{"id":"/docs/guides/dns-setup-60","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#how-it-works","content":"The `include:_spf.north-pipe.ca` directive tells receiving servers to look up NorthRelay's SPF record, which lists NorthRelay's sending IPs (IPv4 and IPv6), so you never need to update SPF when our infrastructure changes. The `-all` suffix means \"reject email from any other source\" — this is the strictest and most secure setting."},"7546":{"id":"/docs/guides/dns-setup-61","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#if-you-already-have-an-spf-record","content":"A domain can only have **one** SPF TXT record. If you already send email through another provider, merge the records:"},"7547":{"id":"/docs/guides/dns-setup-62","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#if-you-already-have-an-spf-record","content":"Do not create a second TXT record starting with `v=spf1` — this will cause SPF to fail entirely."},"7548":{"id":"/docs/guides/dns-setup-63","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Using `~all` (softfail) instead of `-all` (hardfail) — softfail is weaker and may not protect you"},"7549":{"id":"/docs/guides/dns-setup-64","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Adding more than 10 DNS lookups in your SPF chain (SPF has a 10-lookup limit)"},"7550":{"id":"/docs/guides/dns-setup-65","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Creating multiple SPF records on the same domain"},"7551":{"id":"/docs/guides/dns-setup-66","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#common-mistakes","content":"Existing domains using `include:north-pipe.ca` remain supported. New setup instructions use `include:_spf.north-pipe.ca`. Publish only one SPF record."},"7552":{"id":"/docs/guides/dns-setup-67","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#dkim-record","content":"DKIM (DomainKeys Identified Mail) adds a cryptographic signature to each outgoing email, allowing the recipient to verify the message was not altered in transit."},"7553":{"id":"/docs/guides/dns-setup-68","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"For a custom domain, publish the DKIM TXT record shown in Domains & senders at `default._domainkey.yourdomain.com`. Copy the full signing key from the dashboard. NorthRelay manages the signing infrastructure; you manage DNS for your custom domain. Managed NorthRelay domains are configured automatically."},"7554":{"id":"/docs/guides/dns-setup-69","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"To verify your domain:"},"7555":{"id":"/docs/guides/dns-setup-70","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"Go to **Dashboard → Domains**"},"7556":{"id":"/docs/guides/dns-setup-71","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"Click **Add Domain** and enter your domain name"},"7557":{"id":"/docs/guides/dns-setup-72","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"Add the per-domain ownership TXT record at `_northrelay.yourdomain.com`, plus the SPF and DKIM TXT records shown in the dashboard"},"7558":{"id":"/docs/guides/dns-setup-73","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"Click **Verify**"},"7559":{"id":"/docs/guides/dns-setup-74","page_id":"/docs/guides/dns-setup","tags":[],"type":"text","url":"/docs/guides/dns-setup#configure-your-domain","content":"Once verified, DKIM signing is enabled automatically"},"7560":{"i