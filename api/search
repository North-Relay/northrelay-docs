cp-server-10","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#windsurf","content":"Windsurf"},"3881":{"id":"/docs/sdks/mcp-server-11","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#hosted-mode","content":"Hosted mode"},"3882":{"id":"/docs/sdks/mcp-server-12","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#connector-mode","content":"Connector mode"},"3883":{"id":"/docs/sdks/mcp-server-13","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#tool-groups","content":"Tool Groups"},"3884":{"id":"/docs/sdks/mcp-server-14","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#usage-examples","content":"Usage Examples"},"3885":{"id":"/docs/sdks/mcp-server-15","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#sending-emails","content":"Sending Emails"},"3886":{"id":"/docs/sdks/mcp-server-16","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#managing-templates","content":"Managing Templates"},"3887":{"id":"/docs/sdks/mcp-server-17","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#checking-delivery-status","content":"Checking Delivery Status"},"3888":{"id":"/docs/sdks/mcp-server-18","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#deliverability-checks","content":"Deliverability Checks"},"3889":{"id":"/docs/sdks/mcp-server-19","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#campaign-management","content":"Campaign Management"},"3890":{"id":"/docs/sdks/mcp-server-20","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#mailing-lists-and-subscriptions","content":"Mailing Lists and Subscriptions"},"3891":{"id":"/docs/sdks/mcp-server-21","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#troubleshooting","content":"Troubleshooting"},"3892":{"id":"/docs/sdks/mcp-server-22","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#server-not-starting","content":"Server Not Starting"},"3893":{"id":"/docs/sdks/mcp-server-23","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#tools-not-appearing-in-ai-client","content":"Tools Not Appearing in AI Client"},"3894":{"id":"/docs/sdks/mcp-server-24","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#authentication-errors","content":"Authentication Errors"},"3895":{"id":"/docs/sdks/mcp-server-25","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#hosted-endpoint-connects-but-shows-no-tools","content":"Hosted Endpoint Connects But Shows No Tools"},"3896":{"id":"/docs/sdks/mcp-server-26","page_id":"/docs/sdks/mcp-server","type":"heading","tags":[],"url":"/docs/sdks/mcp-server#related","content":"Related"},"3897":{"id":"/docs/sdks/mcp-server-27","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#mcp-server","content":"The NorthRelay MCP Server (`@northrelay/mcp-server` 1.9.0) exposes the full NorthRelay API as tools that AI agents can use directly. It implements the Model Context Protocol (MCP) standard, allowing AI assistants to send emails, manage templates, check delivery status, and more through natural language."},"3898":{"id":"/docs/sdks/mcp-server-28","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"The Model Context Protocol (MCP) is an open standard that lets AI applications interact with external services through structured tool calls. Instead of writing code, you describe what you want in plain language, and the AI agent calls the appropriate NorthRelay tools on your behalf."},"3899":{"id":"/docs/sdks/mcp-server-29","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"**Supported AI clients:**"},"3900":{"id":"/docs/sdks/mcp-server-30","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Claude Code"},"3901":{"id":"/docs/sdks/mcp-server-31","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Claude Desktop"},"3902":{"id":"/docs/sdks/mcp-server-32","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Codex (CLI, IDE extension and desktop app)"},"3903":{"id":"/docs/sdks/mcp-server-33","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Cursor"},"3904":{"id":"/docs/sdks/mcp-server-34","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Windsurf"},"3905":{"id":"/docs/sdks/mcp-server-35","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"Any MCP-compatible client"},"3906":{"id":"/docs/sdks/mcp-server-36","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#what-is-mcp","content":"The server runs in one of two modes. Over **stdio** the client starts it\nlocally and gives it your NorthRelay API key. In **hosted (HTTP)** mode one\nrunning instance serves a team over the network, callers present a bearer\ntoken, and the API key stays on the host. See Hosted mode."},"3907":{"id":"/docs/sdks/mcp-server-37","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#installation","content":"No separate installation is needed. The server runs via `npx`:"},"3908":{"id":"/docs/sdks/mcp-server-38","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#installation","content":"Or install globally:"},"3909":{"id":"/docs/sdks/mcp-server-39","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable             | Required | Default | Description             |\n| -------------------- | -------- | ------- | ----------------------- |\n| `NORTHRELAY_API_KEY` | Yes      | —       | Your NorthRelay API key |","table":"table-0"},"3910":{"id":"/docs/sdks/mcp-server-40","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable              | Required | Default                     | Description         |\n| --------------------- | -------- | --------------------------- | ------------------- |\n| `NORTHRELAY_BASE_URL` | No       | `https://app.northrelay.ca` | Custom API base URL |","table":"table-0"},"3911":{"id":"/docs/sdks/mcp-server-41","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable                    | Required         | Default | Description                                                                          |\n| --------------------------- | ---------------- | ------- | ------------------------------------------------------------------------------------ |\n| `NORTHRELAY_MCP_AUTH_TOKEN` | Hosted mode only | —       | Bearer token(s) callers must present; comma-separate several to rotate without a gap |","table":"table-0"},"3912":{"id":"/docs/sdks/mcp-server-42","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable              | Required | Default | Description                          |\n| --------------------- | -------- | ------- | ------------------------------------ |\n| `NORTHRELAY_MCP_PORT` | No       | `3010`  | Port for hosted mode (`--port` wins) |","table":"table-0"},"3913":{"id":"/docs/sdks/mcp-server-43","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable              | Required | Default     | Description                               |\n| --------------------- | -------- | ----------- | ----------------------------------------- |\n| `NORTHRELAY_MCP_BIND` | No       | `127.0.0.1` | Interface for hosted mode (`--bind` wins) |","table":"table-0"},"3914":{"id":"/docs/sdks/mcp-server-44","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"| Variable                        | Required | Default  | Description                                |\n| ------------------------------- | -------- | -------- | ------------------------------------------ |\n| `NORTHRELAY_MCP_SESSION_TTL_MS` | No       | `600000` | Close a hosted session left idle this long |","table":"table-0"},"3915":{"id":"/docs/sdks/mcp-server-45","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#environment-variables","content":"Keep the API key and the bearer token out of files you commit or text you\npaste. Where a client can read a secret from the environment, the examples\nbelow do that."},"3916":{"id":"/docs/sdks/mcp-server-46","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"Over stdio, with the API key passed through `--env`:"},"3917":{"id":"/docs/sdks/mcp-server-47","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"Against a hosted endpoint, with the bearer as a header (`--scope user` makes\nit available in every project):"},"3918":{"id":"/docs/sdks/mcp-server-48","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"In a project's checked-in `.mcp.json`, write the placeholder and Claude Code\nexpands it from the environment when it loads:"},"3919":{"id":"/docs/sdks/mcp-server-49","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-code","content":"`claude mcp list`, or `/mcp` inside a session, shows whether it connected."},"3920":{"id":"/docs/sdks/mcp-server-50","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"The Codex CLI, IDE extension and desktop app share `~/.codex/config.toml`\n(or a project's `.codex/config.toml`)."},"3921":{"id":"/docs/sdks/mcp-server-51","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"Over stdio:"},"3922":{"id":"/docs/sdks/mcp-server-52","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"which writes:"},"3923":{"id":"/docs/sdks/mcp-server-53","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#codex","content":"Against a hosted endpoint, name the environment variable that holds the\nbearer — the file itself never contains it:"},"3924":{"id":"/docs/sdks/mcp-server-54","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Add the following to your Claude Desktop configuration file:"},"3925":{"id":"/docs/sdks/mcp-server-55","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"**macOS:** `~/Library/Application Support/Claude/claude_desktop_config.json`\n**Windows:** `%APPDATA%\\Claude\\claude_desktop_config.json`\n**Linux:** `~/.config/Claude/claude_desktop_config.json`"},"3926":{"id":"/docs/sdks/mcp-server-56","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Restart Claude Desktop after saving the configuration."},"3927":{"id":"/docs/sdks/mcp-server-57","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"**claude.ai and Claude Desktop custom connectors.** The *Add custom\nconnector* dialog reaches a remote MCP server and authenticates by OAuth —\nthere is no field for a bearer token. A hosted instance running in\nconnector mode is what it needs:"},"3928":{"id":"/docs/sdks/mcp-server-58","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Settings → Connectors → *Add custom connector*, with the endpoint URL\n(`https://mcp.example.net/mcp`), no client id and no secret."},"3929":{"id":"/docs/sdks/mcp-server-59","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"A NorthRelay sign-in page opens. It names the client that is asking and\nthe address the token will be sent to, and starts from read-only\npermissions; tick exactly what the connector should be able to do."},"3930":{"id":"/docs/sdks/mcp-server-60","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"Approving issues an API key named `oauth-<client>-…`. It appears under\n**Settings → API Keys**, expires after 30 days (the connector renews it\nitself), and revoking it there ends the connector's access."},"3931":{"id":"/docs/sdks/mcp-server-61","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#claude-desktop","content":"A hosted instance that serves only a shared token cannot be added as a\nconnector; use Claude Code or Codex for that one."},"3932":{"id":"/docs/sdks/mcp-server-62","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"In Cursor settings, add an MCP server with:"},"3933":{"id":"/docs/sdks/mcp-server-63","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Name:** `northrelay`"},"3934":{"id":"/docs/sdks/mcp-server-64","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Command:** `npx @northrelay/mcp-server`"},"3935":{"id":"/docs/sdks/mcp-server-65","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#cursor","content":"**Environment:** `NORTHRELAY_API_KEY=nr_live_your_api_key_here`"},"3936":{"id":"/docs/sdks/mcp-server-66","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#windsurf","content":"Add to your Windsurf MCP configuration:"},"3937":{"id":"/docs/sdks/mcp-server-67","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"By default the server speaks stdio and each client spawns its own copy. Pass\n`--http` to serve Streamable HTTP instead, so a team, a CI job, or an agent\nrunning elsewhere can share one instance without holding the API key:"},"3938":{"id":"/docs/sdks/mcp-server-68","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"The MCP endpoint is `/mcp`; `GET /healthz` is an unauthenticated probe."},"3939":{"id":"/docs/sdks/mcp-server-69","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"A bearer token is **required**. The endpoint can send real mail, rewrite\ntemplates and clear suppressions, so the server refuses to start without\n`NORTHRELAY_MCP_AUTH_TOKEN` and answers `401` to a wrong one. Every caller\npresents `Authorization: Bearer <token>`."},"3940":{"id":"/docs/sdks/mcp-server-70","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"It binds `127.0.0.1` by default. Put it behind a reverse proxy that\nterminates TLS rather than exposing the port directly."},"3941":{"id":"/docs/sdks/mcp-server-71","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"A session idle past `NORTHRELAY_MCP_SESSION_TTL_MS` is closed, so a client\nthat crashes without ending its session is not held forever."},"3942":{"id":"/docs/sdks/mcp-server-72","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#hosted-mode","content":"To check an endpoint from a client machine:"},"3943":{"id":"/docs/sdks/mcp-server-73","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Set `NORTHRELAY_MCP_PUBLIC_URL` to the origin the instance is reached at,\nand a caller may present its **own** NorthRelay API key as the bearer\ninstead of the shared token:"},"3944":{"id":"/docs/sdks/mcp-server-74","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"Each session then acts as the key it presented — scoped and revocable in\nthat account's key list — and the process needs no `NORTHRELAY_API_KEY` of\nits own unless it also serves a shared token. The server publishes\n`/.well-known/oauth-protected-resource` naming the NorthRelay platform as\nits authorization server, which is how the claude.ai and Claude Desktop\nconnectors find their way to the sign-in page. A key is checked with the\nplatform once, when a session opens; a revoked key is refused at the next\nsession."},"3945":{"id":"/docs/sdks/mcp-server-75","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"| Variable                    | Description                                                                                     |\n| --------------------------- | ----------------------------------------------------------------------------------------------- |\n| `NORTHRELAY_MCP_PUBLIC_URL` | This endpoint's public origin, `https://` (or `http://localhost` for a local instance), no path |","table":"table-1"},"3946":{"id":"/docs/sdks/mcp-server-76","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#connector-mode","content":"The platform side needs nothing configured: every NorthRelay account can\napprove connectors, and `OAUTH_CONNECTORS_DISABLED=true` on the platform\nswitches the authorization server off."},"3947":{"id":"/docs/sdks/mcp-server-77","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#tool-groups","content":"The MCP server (1.7.0) exposes 149 tools in 21 groups."},"3948":{"id":"/docs/sdks/mcp-server-78","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#tool-groups","content":"| Group      | Tools                            | Description                             |\n| ---------- | -------------------------------- | --------------------------------------- |\n| **emails** | `send_email`, `get_email_events` | Send email and read its delivery events |","table":"table-2"},"3949":{"id":"/docs/sdks/mcp-server-79","page_id":"/docs/sdks/mcp-server","tags":[],"type":"text","url":"/docs/sdks/mcp-server#tool-groups","content":"| Group                      | Tools                                                                                                                                                                                                                                                                                                                                                      | Description                                                          |\n| -------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------- |\n| **templates** (deprecated) | `list_templates`, `get_template`, `create_template`, `update_tem