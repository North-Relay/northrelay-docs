s#create-a-contact-list","content":"Create a contact list"},"153":{"id":"/docs/api-reference/contacts-29","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#get-a-contact-list","content":"Get a contact list"},"154":{"id":"/docs/api-reference/contacts-30","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#update-a-contact-list","content":"Update a contact list"},"155":{"id":"/docs/api-reference/contacts-31","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#archive-a-contact-list","content":"Archive a contact list"},"156":{"id":"/docs/api-reference/contacts-32","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#list-members","content":"List Members"},"157":{"id":"/docs/api-reference/contacts-33","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#list-members-1","content":"List members"},"158":{"id":"/docs/api-reference/contacts-34","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#add-members","content":"Add members"},"159":{"id":"/docs/api-reference/contacts-35","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#remove-members","content":"Remove members"},"160":{"id":"/docs/api-reference/contacts-36","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#sdk","content":"SDK"},"161":{"id":"/docs/api-reference/contacts-37","page_id":"/docs/api-reference/contacts","type":"heading","tags":[],"url":"/docs/api-reference/contacts#contact-object-reference","content":"Contact Object Reference"},"162":{"id":"/docs/api-reference/contacts-38","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#contacts-api","content":"The Contacts API stores recipient information, organizes contacts into lists, and manages tags for targeted campaigns. Every route on this page works with an API key (`Authorization: Bearer nr_live_...`) as well as from the dashboard."},"163":{"id":"/docs/api-reference/contacts-39","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#contacts-api","content":"To subscribe someone with consent evidence and double opt-in, or to unsubscribe them, use the Subscriptions API instead of writing contact status directly: it applies the opt-out rules, records consent and fires the `contact.*` and `list.*` webhooks."},"164":{"id":"/docs/api-reference/contacts-40","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#scopes","content":"| Routes                                                        | Scope           |\n| ------------------------------------------------------------- | --------------- |\n| `GET` on any `/contacts/**` route, and `GET /contacts/export` | `contacts:read` |","table":"table-0"},"165":{"id":"/docs/api-reference/contacts-41","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#scopes","content":"| Routes                                                       | Scope            |\n| ------------------------------------------------------------ | ---------------- |\n| `POST`, `PATCH`, `PUT`, `DELETE` on any `/contacts/**` route | `contacts:write` |","table":"table-0"},"166":{"id":"/docs/api-reference/contacts-42","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#response-format","content":"Contact routes (`/contacts`, `/contacts/{id}`, tags, bulk) use the standard envelope: `{ \"success\": true, \"data\": ... }` on success and `{ \"success\": false, \"error\": { \"code\", \"message\", \"fix_action\", \"docs_url\" } }` on failure. List routes (`/contacts/lists/**`) return `{ \"data\": ... }`; their newer member endpoints also include `success`. Import returns the result object directly."},"167":{"id":"/docs/api-reference/contacts-43","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type    | Default | Description |\n| --------- | ------- | ------- | ----------- |\n| `page`    | integer | `1`     | Page number |","table":"table-1"},"168":{"id":"/docs/api-reference/contacts-44","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type    | Default | Description               |\n| --------- | ------- | ------- | ------------------------- |\n| `limit`   | integer | `100`   | Items per page (max 1000) |","table":"table-1"},"169":{"id":"/docs/api-reference/contacts-45","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type   | Default | Description                                                    |\n| --------- | ------ | ------- | -------------------------------------------------------------- |\n| `status`  | string | --      | `ACTIVE`, `UNSUBSCRIBED`, `BOUNCED`, `COMPLAINED` or `CLEANED` |","table":"table-1"},"170":{"id":"/docs/api-reference/contacts-46","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type   | Default | Description                                     |\n| --------- | ------ | ------- | ----------------------------------------------- |\n| `source`  | string | --      | `MANUAL`, `CSV_IMPORT`, `API`, `FORM` or `SYNC` |","table":"table-1"},"171":{"id":"/docs/api-reference/contacts-47","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type   | Default | Description                 |\n| --------- | ------ | ------- | --------------------------- |\n| `tag`     | string | --      | Only contacts with this tag |","table":"table-1"},"172":{"id":"/docs/api-reference/contacts-48","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type   | Default | Description                                               |\n| --------- | ------ | ------- | --------------------------------------------------------- |\n| `search`  | string | --      | Matches email, first name or last name (case-insensitive) |","table":"table-1"},"173":{"id":"/docs/api-reference/contacts-49","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter | Type   | Default     | Description                            |\n| --------- | ------ | ----------- | -------------------------------------- |\n| `sortBy`  | string | `createdAt` | `createdAt`, `email` or `subscribedAt` |","table":"table-1"},"174":{"id":"/docs/api-reference/contacts-50","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"| Parameter   | Type   | Default | Description     |\n| ----------- | ------ | ------- | --------------- |\n| `sortOrder` | string | `desc`  | `asc` or `desc` |","table":"table-1"},"175":{"id":"/docs/api-reference/contacts-51","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#query-parameters","content":"To list the members of one list, use `GET /contacts/lists/{id}/members`."},"176":{"id":"/docs/api-reference/contacts-52","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-response","content":"The example is abridged: contacts also carry `userId`, `consentIp`, `consentUserAgent`, `consentText`, engagement fields and `confirmationFormId`."},"177":{"id":"/docs/api-reference/contacts-53","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#get-contact","content":"Returns the contact with its `tags` and `customFields`. Unknown ids and contacts of other accounts return `404 RESOURCE_NOT_FOUND`."},"178":{"id":"/docs/api-reference/contacts-54","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#get-contact","content":"For a contact's lists, topics and consent evidence in one call, use `GET /subscriptions/{email}`."},"179":{"id":"/docs/api-reference/contacts-55","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-contact","content":"Rate limited to 60 requests per minute per client. For larger loads use bulk create or CSV import."},"180":{"id":"/docs/api-reference/contacts-56","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field   | Type   | Required | Description                        |\n| ------- | ------ | -------- | ---------------------------------- |\n| `email` | string | Yes      | Contact email address (lowercased) |","table":"table-2"},"181":{"id":"/docs/api-reference/contacts-57","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field       | Type   | Required | Description        |\n| ----------- | ------ | -------- | ------------------ |\n| `firstName` | string | No       | Max 100 characters |","table":"table-2"},"182":{"id":"/docs/api-reference/contacts-58","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field      | Type   | Required | Description        |\n| ---------- | ------ | -------- | ------------------ |\n| `lastName` | string | No       | Max 100 characters |","table":"table-2"},"183":{"id":"/docs/api-reference/contacts-59","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field   | Type   | Required | Description                              |\n| ------- | ------ | -------- | ---------------------------------------- |\n| `phone` | string | No       | E.164 format, for example `+15145551234` |","table":"table-2"},"184":{"id":"/docs/api-reference/contacts-60","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field      | Type   | Required | Description              |\n| ---------- | ------ | -------- | ------------------------ |\n| `metadata` | object | No       | Arbitrary JSON, max 4 KB |","table":"table-2"},"185":{"id":"/docs/api-reference/contacts-61","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field    | Type   | Required | Description                                                         |\n| -------- | ------ | -------- | ------------------------------------------------------------------- |\n| `source` | string | No       | `MANUAL`, `CSV_IMPORT`, `API`, `FORM` or `SYNC`. Defaults to `API`. |","table":"table-2"},"186":{"id":"/docs/api-reference/contacts-62","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field    | Type   | Required | Description                                                              |\n| -------- | ------ | -------- | ------------------------------------------------------------------------ |\n| `status` | string | No       | `ACTIVE` (default), `UNSUBSCRIBED`, `BOUNCED`, `COMPLAINED` or `CLEANED` |","table":"table-2"},"187":{"id":"/docs/api-reference/contacts-63","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field  | Type     | Required | Description                                                                   |\n| ------ | -------- | -------- | ----------------------------------------------------------------------------- |\n| `tags` | string[] | No       | Up to 50 tags; lowercase letters, digits, `-` and `_`, max 50 characters each |","table":"table-2"},"188":{"id":"/docs/api-reference/contacts-64","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"| Field          | Type   | Required | Description            |\n| -------------- | ------ | -------- | ---------------------- |\n| `customFields` | object | No       | String key/value pairs |","table":"table-2"},"189":{"id":"/docs/api-reference/contacts-65","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#request-body","content":"This route does not add the contact to lists, record consent evidence or fire webhooks. To do that in one call, use `POST /subscriptions`."},"190":{"id":"/docs/api-reference/contacts-66","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-request-1","content":"Returns `201` with the created contact (including `tags` and `customFields`) in `data`."},"191":{"id":"/docs/api-reference/contacts-67","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors","content":"| Code               | Status | Fix                                              |\n| ------------------ | ------ | ------------------------------------------------ |\n| `VALIDATION_ERROR` | 400    | Correct the field named in `error.context.field` |","table":"table-3"},"192":{"id":"/docs/api-reference/contacts-68","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors","content":"| Code                | Status | Fix                                                                             |\n| ------------------- | ------ | ------------------------------------------------------------------------------- |\n| `DUPLICATE_CONTACT` | 409    | A contact with this email already exists. Update it with `PATCH /contacts/{id}` |","table":"table-3"},"193":{"id":"/docs/api-reference/contacts-69","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors","content":"| Code                  | Status | Fix                                      |\n| --------------------- | ------ | ---------------------------------------- |\n| `RATE_LIMIT_EXCEEDED` | 429    | Wait `error.context.retry_after` seconds |","table":"table-3"},"194":{"id":"/docs/api-reference/contacts-70","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"Only the fields you send are changed. Accepts `email`, `firstName`, `lastName`, `phone`, `metadata`, `source` and `status`. Use the tag routes for tags."},"195":{"id":"/docs/api-reference/contacts-71","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"Status changes must follow the allowed transitions:"},"196":{"id":"/docs/api-reference/contacts-72","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"| From      | Allowed to                          |\n| --------- | ----------------------------------- |\n| `PENDING` | `ACTIVE`, `UNSUBSCRIBED`, `CLEANED` |","table":"table-4"},"197":{"id":"/docs/api-reference/contacts-73","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"| From     | Allowed to                                         |\n| -------- | -------------------------------------------------- |\n| `ACTIVE` | `UNSUBSCRIBED`, `BOUNCED`, `COMPLAINED`, `CLEANED` |","table":"table-4"},"198":{"id":"/docs/api-reference/contacts-74","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"| From           | Allowed to          |\n| -------------- | ------------------- |\n| `UNSUBSCRIBED` | `ACTIVE`, `PENDING` |","table":"table-4"},"199":{"id":"/docs/api-reference/contacts-75","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"| From      | Allowed to |\n| --------- | ---------- |\n| `BOUNCED` | `ACTIVE`   |","table":"table-4"},"200":{"id":"/docs/api-reference/contacts-76","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"| From                    | Allowed to      |\n| ----------------------- | --------------- |\n| `COMPLAINED`, `CLEANED` | none (terminal) |","table":"table-4"},"201":{"id":"/docs/api-reference/contacts-77","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-contact","content":"An invalid transition returns `400 INVALID_STATUS_TRANSITION`. Changing `status` here only updates the contact; it does not add or lift suppressions or fire webhooks. To unsubscribe or resubscribe someone, use the Subscriptions API."},"202":{"id":"/docs/api-reference/contacts-78","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#delete-contact","content":"Permanently deletes the contact, its tags, custom fields and list memberships. Suppressions are kept, so a deleted address that had unsubscribed stays suppressed."},"203":{"id":"/docs/api-reference/contacts-79","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-tags-to-a-contact","content":"`tags` takes 1–50 tags (lowercase letters, digits, `-` and `_`). Existing tags are kept. Returns the contact with its tags. A contact holds at most 50 tags; exceeding that returns `400 TAG_LIMIT_EXCEEDED`."},"204":{"id":"/docs/api-reference/contacts-80","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-tags-in-your-account","content":"Returns `{ \"data\": [{ \"name\", \"count\", \"color\", \"definitionId\" }] }` with the number of contacts carrying each tag."},"205":{"id":"/docs/api-reference/contacts-81","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#bulk-create","content":"| Field      | Type     | Required | Description                                           |\n| ---------- | -------- | -------- | ----------------------------------------------------- |\n| `contacts` | object[] | Yes      | 1–1,000 contacts, each with the Create Contact fields |","table":"table-5"},"206":{"id":"/docs/api-reference/contacts-82","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#bulk-create","content":"| Field            | Type    | Required | Description                                                                                           |\n| ---------------- | ------- | -------- | ----------------------------------------------------------------------------------------------------- |\n| `skipDuplicates` | boolean | No       | Default `true`: existing emails are counted in `skipped`. With `false` they are reported in `errors`. |","table":"table-5"},"207":{"id":"/docs/api-reference/contacts-83","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#bulk-create","content":"`errors` is a list of `{ \"email\", \"error\" }`. Bulk create does not update existing contacts or add list memberships."},"208":{"id":"/docs/api-reference/contacts-84","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#bulk-delete","content":"`contactIds` takes 1–1,000 ids. Ids that are not yours are ignored (`deleted` < `requested`)."},"209":{"id":"/docs/api-reference/contacts-85","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"Imports a CSV file using multipart form data. New addresses are created as `ACTIVE` contacts with source `CSV_IMPORT` and consent source `import`; existing addresses are counted in `skipped` and not updated."},"210":{"id":"/docs/api-reference/contacts-86","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"| Field  | Type     | Required | Description                                                 |\n| ------ | -------- | -------- | ----------------------------------------------------------- |\n| `file` | CSV file | Yes      | `.csv`, up to 2 MiB and 1,000 data rows plus the header row |","table":"table-6"},"211":{"id":"/docs/api-reference/contacts-87","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"| Field      | Type        | Required | Description                                                                                                                                                                                  |\n| ---------- | ----------- | -------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `mappings` | JSON string | Yes      | Array of `{ \"csvColumn\": \"<header>\", \"field\": \"email\" \\| \"firstName\" \\| \"lastName\" \\| \"phone\" \\| \"skip\" }`. `csvColumn` must match a header exactly. Exactly one column must map to `email`. |","table":"table-6"},"212":{"id":"/docs/api-reference/contacts-88","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"| Field    | Type   | Required | Description                                                                            |\n| -------- | ------ | -------- | -------------------------------------------------------------------------------------- |\n| `listId` | string | No       | Add every imported contact, and every existing contact found in the file, to this list |","table":"table-6"},"213":{"id":"/docs/api-reference/contacts-89","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"| Field  | Type   | Required | Description                                                       |\n| ------ | ------ | -------- | ----------------------------------------------------------------- |\n| `tags` | string | No       | Comma-separated tags applied to newly created contacts (up to 20) |","table":"table-6"},"214":{"id":"/docs/api-reference/contacts-90","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#csv-import","content":"Headers must be unique. Quoted commas, escaped quotes and multiline fields are supported. Maximum 100 columns and 4,096 characters per field; multipart overhead is capped at 64 KiB. Split larger imports into separate requests."},"215":{"id":"/docs/api-reference/contacts-91","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-response-1","content":"| Field      | Description          |\n| ---------- | -------------------- |\n| `imported` | New contacts created |","table":"table-7"},"216":{"id":"/docs/api-reference/contacts-92","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-response-1","content":"| Field     | Description                        |\n| --------- | ---------------------------------- |\n| `skipped` | Rows whose address already existed |","table":"table-7"},"217":{"id":"/docs/api-reference/contacts-93","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-response-1","content":"| Field         | Description                                                                       |\n| ------------- | --------------------------------------------------------------------------------- |\n| `addedToList` | Contacts (new or existing) added to `listId` by this import; `0` without `listId` |","table":"table-7"},"218":{"id":"/docs/api-reference/contacts-94","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#example-response-1","content":"| Field    | Description                  |\n| -------- | ---------------------------- |\n| `errors` | One message per rejected row |","table":"table-7"},"219":{"id":"/docs/api-reference/contacts-95","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors-1","content":"Import errors use a simpler body, `{ \"error\": \"<message>\" }`:"},"220":{"id":"/docs/api-reference/contacts-96","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors-1","content":"| Status | When                                                                                                                                                            |\n| ------ | --------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| 400    | No file, not a `.csv`, invalid `mappings`, no email mapping, mapped email column missing, duplicate headers, malformed CSV, or row/column/field limits exceeded |","table":"table-8"},"221":{"id":"/docs/api-reference/contacts-97","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors-1","content":"| Status | When                              |\n| ------ | --------------------------------- |\n| 404    | `listId` is not one of your lists |","table":"table-8"},"222":{"id":"/docs/api-reference/contacts-98","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors-1","content":"| Status | When                                 |\n| ------ | ------------------------------------ |\n| 413    | File over 2 MiB or request too large |","table":"table-8"},"223":{"id":"/docs/api-reference/contacts-99","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#errors-1","content":"Importing never clears suppressions: an address that bounced, complained or unsubscribed stays suppressed, and campaigns skip it. Only import addresses that agreed to receive your mail; import does not fire `contact.subscribed` or `list.member_added` webhooks."},"224":{"id":"/docs/api-reference/contacts-100","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#contact-lists","content":"Lists are named audiences for campaigns. A list can be tagged with a topic (`suppressionGroupId`): recipients who opt out of that topic leave the list and are skipped when you send to it. See Suppressions: topics."},"225":{"id":"/docs/api-reference/contacts-101","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"| Parameter | Type    | Default | Description |\n| --------- | ------- | ------- | ----------- |\n| `page`    | integer | `1`     | Page number |","table":"table-9"},"226":{"id":"/docs/api-reference/contacts-102","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"| Parameter | Type    | Default | Description              |\n| --------- | ------- | ------- | ------------------------ |\n| `limit`   | integer | `20`    | Items per page (max 100) |","table":"table-9"},"227":{"id":"/docs/api-reference/contacts-103","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"| Parameter | Type   | Default | Description                  |\n| --------- | ------ | ------- | ---------------------------- |\n| `type`    | string | --      | `STATIC`, `DYNAMIC` or `ALL` |","table":"table-9"},"228":{"id":"/docs/api-reference/contacts-104","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"| Parameter    | Type    | Default | Description                 |\n| ------------ | ------- | ------- | --------------------------- |\n| `isArchived` | boolean | `false` | Show archived lists instead |","table":"table-9"},"229":{"id":"/docs/api-reference/contacts-105","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"| Parameter | Type   | Default | Description                 |\n| --------- | ------ | ------- | --------------------------- |\n| `search`  | string | --      | Matches name or description |","table":"table-9"},"230":{"id":"/docs/api-reference/contacts-106","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-all-contact-lists","content":"`contactCount` counts current members (removed memberships are excluded)."},"231":{"id":"/docs/api-reference/contacts-107","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field  | Type   | Required | Description      |\n| ------ | ------ | -------- | ---------------- |\n| `name` | string | Yes      | 1–255 characters |","table":"table-10"},"232":{"id":"/docs/api-reference/contacts-108","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field         | Type   | Required | Description          |\n| ------------- | ------ | -------- | -------------------- |\n| `description` | string | No       | Max 1,000 characters |","table":"table-10"},"233":{"id":"/docs/api-reference/contacts-109","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field  | Type   | Required | Description                     |\n| ------ | ------ | -------- | ------------------------------- |\n| `type` | string | No       | `STATIC` (default) or `DYNAMIC` |","table":"table-10"},"234":{"id":"/docs/api-reference/contacts-110","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field          | Type   | Required | Description              |\n| -------------- | ------ | -------- | ------------------------ |\n| `segmentRules` | object | No       | Rules for a dynamic list |","table":"table-10"},"235":{"id":"/docs/api-reference/contacts-111","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field                | Type           | Required | Description                |\n| -------------------- | -------------- | -------- | -------------------------- |\n| `suppressionGroupId` | string \\| null | No       | Topic this list belongs to |","table":"table-10"},"236":{"id":"/docs/api-reference/contacts-112","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"| Field             | Type    | Required | Description                                                     |\n| ----------------- | ------- | -------- | --------------------------------------------------------------- |\n| `trackingEnabled` | boolean | No       | Open/click tracking for campaigns to this list (default `true`) |","table":"table-10"},"237":{"id":"/docs/api-reference/contacts-113","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#create-a-contact-list","content":"Returns `201` with `{ \"data\": { ...list } }`."},"238":{"id":"/docs/api-reference/contacts-114","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#get-a-contact-list","content":"Returns `{ \"data\": { ...list } }` including `suppressionGroup` (`{ id, name, publicLabel }` or `null`) and `_count.members`."},"239":{"id":"/docs/api-reference/contacts-115","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#update-a-contact-list","content":"Accepts `name`, `description`, `segmentRules`, `isArchived`, `suppressionGroupId` (set `null` to untag) and `trackingEnabled`."},"240":{"id":"/docs/api-reference/contacts-116","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#archive-a-contact-list","content":"Archives the list (`isArchived: true`). Contacts and memberships are kept. Returns `{ \"success\": true }`."},"241":{"id":"/docs/api-reference/contacts-117","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-members-1","content":"| Parameter | Type    | Default | Description |\n| --------- | ------- | ------- | ----------- |\n| `page`    | integer | `1`     | Page number |","table":"table-11"},"242":{"id":"/docs/api-reference/contacts-118","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-members-1","content":"| Parameter | Type    | Default | Description              |\n| --------- | ------- | ------- | ------------------------ |\n| `limit`   | integer | `50`    | Items per page (max 100) |","table":"table-11"},"243":{"id":"/docs/api-reference/contacts-119","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-members-1","content":"| Parameter | Type   | Default | Description                                            |\n| --------- | ------ | ------- | ------------------------------------------------------ |\n| `filter`  | string | `all`   | `all`, `active` (no suppression flags) or `suppressed` |","table":"table-11"},"244":{"id":"/docs/api-reference/contacts-120","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#list-members-1","content":"Campaigns go only to current members whose contact is not `PENDING`. `suppressionStatuses` lists every reason the member will not receive mail: `REMOVED_FROM_LIST` (unsubscribed from this list), `UNSUBSCRIBED`, `BOUNCED`, `COMPLAINED`, `CLEANED`, `MANUALLY_SUPPRESSED`, `CATEGORY_SUPPRESSED` (opted out of the list's topic)."},"245":{"id":"/docs/api-reference/contacts-121","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"Add existing contacts by id and/or email. With `createMissing: true`, unknown emails are created as `ACTIVE` contacts (source `API`) first."},"246":{"id":"/docs/api-reference/contacts-122","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field        | Type     | Required                       | Description             |\n| ------------ | -------- | ------------------------------ | ----------------------- |\n| `contactIds` | string[] | One of `contactIds` / `emails` | Up to 1,000 contact ids |","table":"table-12"},"247":{"id":"/docs/api-reference/contacts-123","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field    | Type     | Required                       | Description           |\n| -------- | -------- | ------------------------------ | --------------------- |\n| `emails` | string[] | One of `contactIds` / `emails` | Up to 1,000 addresses |","table":"table-12"},"248":{"id":"/docs/api-reference/contacts-124","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field           | Type    | Required | Description                                                                                                                                          |\n| --------------- | ------- | -------- | ---------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `createMissing` | boolean | No       | Create contacts for unknown emails. Addresses that unsubscribed, bounced, complained or are blocked are not created; they are reported in `blocked`. |","table":"table-12"},"249":{"id":"/docs/api-reference/contacts-125","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field        | Description                                           |\n| ------------ | ----------------------------------------------------- |\n| `data.added` | Contacts added (or restored after an earlier removal) |","table":"table-13"},"250":{"id":"/docs/api-reference/contacts-126","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field                 | Description                                |\n| --------------------- | ------------------------------------------ |\n| `data.alreadyMembers` | Contacts that were already current members |","table":"table-13"},"251":{"id":"/docs/api-reference/contacts-127","page_id":"/docs/api-reference/contacts","tags":[],"type":"text","url":"/docs/api-reference/contacts#add-members","content":"| Field           | Description                                                                 |\n| --------------- | --------------------------------------------------------------------------- |\n| `data.notFound` | Ids not in your account, and unknown em